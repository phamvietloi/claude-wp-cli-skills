# Copy to dev/.env (setup.ps1 does this for you). Dev-only values — never reuse real credentials.
SITE_PORT=8095
MAIL_PORT=8096
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=dev-only-password
DB_ROOT_PASSWORD=dev-only-root-password
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=dev-only-admin-password
WP_ADMIN_EMAIL=admin@example.com
# WooCommerce version to pin; setup falls back to the latest release if it is unavailable.
WC_VERSION=11.1.2
